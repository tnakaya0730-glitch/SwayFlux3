add_executable(custom_job examples/custom_job.cpp)
target_link_libraries(custom_job PRIVATE SwayFlux3::core)
if(SWAYFLUX3_BUILD_HTTP)
    add_executable(transfer examples/transfer.cpp)
    target_link_libraries(transfer PRIVATE SwayFlux3::swayflux3)
    add_executable(stream_download examples/stream_download.cpp)
    target_link_libraries(stream_download PRIVATE SwayFlux3::http)
endif()

foreach(target custom_job transfer stream_download)
    if(TARGET ${target})
        swayflux3_configure_compiler(${target})
    endif()
endforeach()
