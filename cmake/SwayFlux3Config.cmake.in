@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(SwayFlux3_core_FOUND TRUE)
set(SwayFlux3_communication_FOUND TRUE)
set(SwayFlux3_http_FOUND @SWAYFLUX3_BUILD_HTTP@)
if(@SWAYFLUX3_BUILD_HTTP@ AND (NOT SwayFlux3_FIND_COMPONENTS OR "http" IN_LIST SwayFlux3_FIND_COMPONENTS))
    find_dependency(CURL 8.0)
    find_dependency(ZLIB)
    find_dependency(zstd CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SwayFlux3Targets.cmake")
check_required_components(SwayFlux3)
